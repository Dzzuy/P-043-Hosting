{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "p=\"$PWD\"; while [ ! -f \"$p/scripts/_pyrun.sh\" ]; do [ \"$p\" != / ] || exit 1; p=\"$(dirname \"$p\")\"; done; bash \"$p/scripts/_pyrun.sh\" \"$p/scripts/log_hook.py\" --tool=codex",
            "timeout": 10,
            "commandWindows": "powershell -NoProfile -ExecutionPolicy Bypass -EncodedCommand "
          }
        ]
      }
    ]
  },
  "description": "Record user prompts locally for AI log submission on Git push."
}
