# ============================================
# AI20K Project — Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# ---- LLM Configuration ----
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL_NAME=openai/gpt-6-luna
EMBEDDING_PROVIDER=openrouter
EMBEDDING_MODEL_NAME=openai/text-embedding-3-small
# Or use other providers:
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=

# ---- Database ----
DATABASE_URL=sqlite:///./data/app.db
# For persistent hosted storage, configure a PostgreSQL URL instead.

# ---- Local Authentication ----
AUTH_COOKIE_NAME=p043_session
AUTH_SESSION_TTL_HOURS=8
AUTH_COOKIE_SECURE=false
# Used only by scripts/seed_demo_users.py; choose local values and never commit them.
DEMO_ADVISOR_PASSWORD=
DEMO_MANAGER_PASSWORD=

# ---- Optional Practice Voice Mode (backend only) ----
GROQ_API_KEY=
# Render secret environment variable containing a service-account JSON document.
# Alternatively configure Google Application Default Credentials for the backend.
GOOGLE_TTS_SERVICE_ACCOUNT_JSON=
# List-price estimates for the per-session voice usage display; adjust when rates change.
VOICE_STT_USD_PER_HOUR=0.04
VOICE_TTS_USD_PER_MILLION_CHARACTERS=16

# ---- Vector Store ----
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_COLLECTION_NAME=vinfast_knowledge_openrouter_3_small
# Or Pinecone:
# PINECONE_API_KEY=
# PINECONE_ENVIRONMENT=

# ---- App Config ----
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- LangSmith (AI Logs — Deliverable #4) ----
LANGCHAIN_API_KEY=your-langsmith-key-here
LANGCHAIN_PROJECT=ai20k-agent
LANGCHAIN_TRACING_V2=true

# ---- LangSmith: Roleplay/Practice (separate account) ----
ROLEPLAY_LANGSMITH_TRACING=false
ROLEPLAY_LANGSMITH_API_KEY=your-roleplay-langsmith-key-here
ROLEPLAY_LANGSMITH_ENDPOINT=https://api.smith.langchain.com
ROLEPLAY_LANGSMITH_PROJECT=
ROLEPLAY_LANGSMITH_CAPTURE_CONTENT=false

# ---- Logging ----
LOG_LEVEL=INFO

# ---- AI Hook Logging (provided by instructor) ----
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=<get-your-api-key-from-dashboard-phoenix>
AI_LOG_DIR=.ai-log

# ---- Frontend (if separate) ----
# NEXT_PUBLIC_API_URL=http://localhost:8000

# Practice evaluation uses a separate judge from the customer/analyzer model.
PRACTICE_JUDGE_PROVIDER=openrouter
PRACTICE_JUDGE_MODEL=google/gemini-3.8-flash
