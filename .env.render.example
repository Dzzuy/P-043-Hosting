# Set these on the Render backend service. Do not commit real values.
APP_ENV=production
AUTH_COOKIE_SECURE=true
# Use the Neon pooled connection URL with TLS enabled.
DATABASE_URL=postgresql://<user>:<password>@<host>-pooler.<region>.aws.neon.tech/<database>?sslmode=require
VECTOR_STORE_TYPE=pgvector
# Use the final Vercel origin; include preview origins only if needed.
CORS_ORIGINS=https://<your-vercel-project>.vercel.app
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=<your-openrouter-api-key>
OPENROUTER_MODEL_NAME=openai/gpt-6-luna
EMBEDDING_PROVIDER=openrouter
EMBEDDING_MODEL_NAME=openai/text-embedding-3-small
# Optional Practice Room voice providers. Set real values only in Render.
GROQ_API_KEY=<your-groq-api-key>
GOOGLE_TTS_SERVICE_ACCOUNT_JSON=<single-line-service-account-json>
VOICE_STT_USD_PER_HOUR=0.04
VOICE_TTS_USD_PER_MILLION_CHARACTERS=16
# One-time first-manager bootstrap; set values privately in Render.
BOOTSTRAP_MANAGER_USERNAME=<manager-login-name>
BOOTSTRAP_MANAGER_DISPLAY_NAME=<manager-display-name>
BOOTSTRAP_MANAGER_PASSWORD=<unique-temporary-password-at-least-16-characters>
