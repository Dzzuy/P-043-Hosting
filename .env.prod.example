# =================================================================
# Production Environment Configuration
# Copy this file to .env.prod on your production server:
#   cp .env.prod.example .env.prod
# Run production deployment:
#   docker compose --env-file .env.prod -f docker-compose.prod.yml up --build -d
# =================================================================

# ---- Application Environment ----
APP_ENV=production
FRONTEND_PORT=80
CORS_ORIGINS=https://your-domain.com

# ---- PostgreSQL Database (Container Internal) ----
POSTGRES_USER=p043_prod
POSTGRES_PASSWORD=Thay_Bang_Mat_Khau_Database_That_Manh_32_Ky_Tu!
POSTGRES_DB=p043_prod

# ---- LLM & Embeddings (OpenRouter) ----
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=sk-or-v1-your-real-openrouter-key
OPENROUTER_MODEL_NAME=google/gemini-2.0-flash-001
EMBEDDING_PROVIDER=openrouter
EMBEDDING_MODEL_NAME=openai/text-embedding-3-small

# ---- Production Authentication ----
AUTH_COOKIE_NAME=p043_session
AUTH_SESSION_TTL_HOURS=8
AUTH_COOKIE_SECURE=true

# ---- Initial Bootstrap Manager (Auto-created on first run) ----
BOOTSTRAP_MANAGER_USERNAME=admin
BOOTSTRAP_MANAGER_DISPLAY_NAME=Quản lý Hệ thống
BOOTSTRAP_MANAGER_PASSWORD=AdminPassword2026!ChangeMe

# ---- Logging & Monitoring ----
LOG_LEVEL=INFO
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=your-ai-log-key
